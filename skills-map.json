{
  "$schema": "https://raw.githubusercontent.com/rigerc/nosey/main/schemas/registry/skills-map.schema.json",
  "schemaVersion": 2,
  "registryId": "rigerc/my-skills",
  "alwaysRecommend": [],
  "externalSkills": [],
  "technologies": [
    {
      "id": "agnix",
      "name": "agnix",
      "detect": {
        "packages": [
          "agnix"
        ],
        "pythonPackages": [
          "agnix"
        ],
        "rustCrates": [
          "agnix-cli"
        ],
        "configFiles": [
          ".agnix.toml"
        ]
      }
    },
    {
      "id": "gum",
      "name": "Charmbracelet Gum",
      "detect": {
        "configFileContent": {
          "files": [
            "Justfile",
            "justfile",
            ".justfile"
          ],
          "sourceExtensions": [
            ".sh",
            ".bash",
            ".zsh",
            ".fish"
          ],
          "patterns": [
            {
              "source": "(^|[;&|()\\s])gum\\s+(choose|confirm|file|filter|format|input|join|pager|spin|style|table|write|log|version-check)\\b",
              "flags": "m"
            }
          ],
          "stripComments": "hash"
        }
      }
    },
    {
      "id": "knap",
      "name": "Knap",
      "detect": {
        "packages": [
          "knap"
        ]
      }
    },
    {
      "id": "mcp-serena",
      "name": "Serena MCP",
      "detect": {
        "mcpServers": [
          {
            "pythonPackages": [
              "serena-agent"
            ]
          },
          {
            "serverNames": [
              "serena"
            ],
            "configFiles": [
              ".mcp.json",
              ".cursor/mcp.json",
              ".vscode/mcp.json",
              ".codex/config.toml"
            ]
          }
        ]
      }
    },
    {
      "id": "mcp-ue4ss-bridge",
      "name": "UE4SS Bridge MCP",
      "detect": {
        "mcpServers": [
          {
            "pythonPackages": [
              "ue4ss-bridge"
            ]
          },
          {
            "serverNames": [
              "ue4ss-bridge"
            ],
            "configFiles": [
              ".mcp.json",
              ".cursor/mcp.json",
              ".vscode/mcp.json",
              ".codex/config.toml"
            ]
          }
        ]
      }
    },
    {
      "id": "noctalia-plugins",
      "name": "Noctalia native Luau plugins",
      "detect": {
        "configFileContent": {
          "files": [
            "plugin.toml"
          ],
          "patterns": [
            {
              "source": "^\\s*plugin_api\\s*=\\s*[0-9]+\\b",
              "flags": "m"
            },
            {
              "source": "^\\s*entry\\s*=\\s*[\"'][^\"'\\r\\n]+\\.luau[\"']",
              "flags": "m"
            }
          ],
          "allPatterns": true,
          "stripComments": "hash"
        }
      }
    },
    {
      "id": "octokit-js",
      "name": "Octokit.js",
      "detect": {
        "packages": [
          "@octokit/core",
          "@octokit/rest",
          "octokit"
        ]
      }
    },
    {
      "id": "vhs",
      "name": "Charmbracelet VHS",
      "detect": {
        "fileExtensions": [
          ".tape"
        ]
      }
    },
    {
      "id": "readme",
      "name": "README documentation",
      "detect": {
        "configFiles": [
          "README.md"
        ]
      }
    }
  ],
